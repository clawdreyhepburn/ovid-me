// OVID Cedar Schema — Generic Agent Authorization Vocabulary
// This is the base schema shipped with @clawdreyhepburn/ovid-me.
// Instance-specific extensions go in ~/.ovid/schema/Ovid.local.cedarschema.

namespace Ovid {

  // ── Principals ──────────────────────────────────────────────

  entity Agent {
    name?: String,
    issuer?: String,
    depth?: Long,          // 0 = root, 1 = child, 2 = grandchild...
  };

  // ── Resources (nouns) ──────────────────────────────────────

  entity File {
    path: String,
  };

  entity Shell {
    command: String,
    args?: String,
  };

  entity Tool {
    name: String,
  };

  entity WebEndpoint {
    url?: String,
    hostname?: String,
  };

  entity Channel {
    provider: String,      // "telegram", "discord", "signal", "imessage", etc.
    target?: String,       // chat/channel/group ID
  };

  entity Memory {
    path?: String,
  };

  entity Session {
    key?: String,
  };

  // ── Actions (verbs) ────────────────────────────────────────
  //
  // These are the generic actions any OpenClaw agent might perform.
  // Each action declares which resource types it applies to.

  // Filesystem
  action "read" appliesTo {
    principal: [Agent],
    resource: [File, Memory, Tool],
    context: {},
  };

  action "write" appliesTo {
    principal: [Agent],
    resource: [File, Memory],
    context: {},
  };

  action "edit" appliesTo {
    principal: [Agent],
    resource: [File],
    context: {},
  };

  // Shell execution
  action "exec" appliesTo {
    principal: [Agent],
    resource: [Shell],
    context: {},
  };

  // Network
  action "fetch" appliesTo {
    principal: [Agent],
    resource: [WebEndpoint],
    context: {},
  };

  action "search" appliesTo {
    principal: [Agent],
    resource: [WebEndpoint, Tool],
    context: {},
  };

  action "browse" appliesTo {
    principal: [Agent],
    resource: [WebEndpoint],
    context: {},
  };

  // Messaging
  action "send" appliesTo {
    principal: [Agent],
    resource: [Channel],
    context: {},
  };

  // Delegation
  action "delegate" appliesTo {
    principal: [Agent],
    resource: [Session],
    context: {},
  };

  // Memory operations
  action "remember" appliesTo {
    principal: [Agent],
    resource: [Memory],
    context: {},
  };

  action "recall" appliesTo {
    principal: [Agent],
    resource: [Memory, Tool],
    context: {},
  };

  // Generic fallback — used when no specific action matches
  action "call_tool" appliesTo {
    principal: [Agent],
    resource: [Tool],
    context: {},
  };

  action "summarize" appliesTo {
    principal: [Agent],
    resource: [Tool, File, WebEndpoint],
    context: {},
  };
}
